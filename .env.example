# Server & Security Configuration
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
ADMIN_API_KEY=

# Datastore URIs
MONGO_URI=mongodb://localhost:27017/polyglot_platform
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Forecasting microservice endpoint
FORECASTING_SERVICE_URL=http://localhost:5001

# Cache & Storage Optimizer Configuration
CACHE_STRATEGY=adaptive
CACHE_ASIDE_TTL_SECONDS=300
OPTIMIZER_INTERVAL_SECONDS=30
OPTIMIZER_PROMOTE_THRESHOLD=3
OPTIMIZER_DEMOTE_THRESHOLD=1
OPTIMIZER_CACHE_TTL_SECONDS=300
OPTIMIZER_RECENT_WINDOW_MINUTES=5

# GenAI Layer Configuration (supports: mock, openai, anthropic)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

